# Находим GoogleTest
find_package(GTest REQUIRED)

# Указываем полный путь к исходному файлу теста
add_executable(graphhlib_test 


# Линкуем с GTest
target_link_libraries(graphlib_test 
    GTest::GTest 
    GTest::Main
)

# Указываем выходной каталог
set_target_propertiesgraphlib_test 
    PROPERTIES 
    RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin
)

# Добавляем тест в CTest
add_test(
    NAME graphlib_test 
    COMMAND ${CMAKE_BINARY_DIR}/bin/graphlib_test
)
